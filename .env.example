# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → service_role (server-only, never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (AI provider: scoring, briefs, email drafts) ─────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Resend (email sending) ─────────────────────────────────────────────────
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account
RESEND_FROM_EMAIL="Arjun Mehta <arjun@kargo.example.com>"

# ── App ─────────────────────────────────────────────────────────────────────
# Shared secret so only the founder's browser can call the internal API routes.
# Set any long random string; the dashboard will prompt for it once and store
# it in a cookie.
APP_ACCESS_CODE=
